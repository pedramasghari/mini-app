NODE_ENV=development
PORT=4000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=miniapp
DATABASE_PASSWORD=miniapp_password
DATABASE_NAME=miniapp

# Telegram bot token used both for Mini App authentication and notifications.
TELEGRAM_BOT_TOKEN=123456:REPLACE_ME
# Optional legacy fallback; TELEGRAM_BOT_TOKEN is preferred.
ADMIN_BOT_TOKEN=123456:REPLACE_ME

# Comma-separated Telegram numeric IDs that are administrators.
ADMIN_TELEGRAM_IDS=123456789

# Local proxy used by grammY for Telegram API traffic.
TELEGRAM_PROXY_URL=http://127.0.0.1:2080

# URL opened by the Telegram Mini App button.
MINI_APP_URL=https://example.com
FRONTEND_URL=http://localhost:3000

# SMS verification is intentionally not wired into Apple ID account creation.
# Keep third-party verification credentials out of source control.
