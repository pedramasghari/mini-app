NODE_ENV=development
PORT=4000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=miniapp
DATABASE_PASSWORD=miniapp_password
DATABASE_NAME=miniapp

# Telegram bot token used both for Mini App authentication and notifications.
TELEGRAM_BOT_TOKEN=123456:REPLACE_ME
ADMIN_BOT_TOKEN=123456:REPLACE_ME
ADMIN_TELEGRAM_IDS=123456789
TELEGRAM_PROXY_URL=http://127.0.0.1:2080

MINI_APP_URL=https://example.com
FRONTEND_URL=http://localhost:3000

# SMSCode API.
SMSCODE_API_VERSION=v1
SMSCODE_API_TOKEN=REPLACE_ME
SMSCODE_WEBHOOK_URL=https://api.example.com/webhooks/smscode

# Zibal IPG
ZIBAL_ENABLED=true
ZIBAL_MERCHANT=REPLACE_ME
# Must be a public HTTPS URL reachable by Zibal. When Nginx fronts the Mini App,
# use the /api prefix so the callback is routed to NestJS, for example:
# https://app.example.com/api/zibal/callback
ZIBAL_CALLBACK_URL=https://app.example.com/api/zibal/callback
# Wallet amounts are stored in IRT (Toman). Zibal receives Rials, so the module multiplies by 10.
ZIBAL_MIN_DEPOSIT_IRT=1000
ZIBAL_MAX_DEPOSIT_IRT=50000000
ZIBAL_TIMEOUT_MS=15000
